# Copy to .env and fill in. Never commit .env.
# Every variable is documented in README.md ("Configuration").

# --- General ---------------------------------------------------------------------
FIM_LOG_LEVEL=INFO

# --- Cameras ---------------------------------------------------------------------
# Comma-separated camera ids (lowercase letters, digits, underscore).
FIM_CAMERAS=cam1
# Main (high-quality) stream of each camera, recorded. Credentials are masked in logs.
# Development: "publisher" accepts the simulated camera instead of pulling a camera.
FIM_CAMERA_CAM1_MAIN_URL=rtsp://user:password@camera-host:554/stream1
# Optional substream used for analysis (recommended).
FIM_CAMERA_CAM1_SUB_URL=rtsp://user:password@camera-host:554/stream2
# Optional zone file (safe zones: bed, sofa, mattress), written by "fim zones".
# FIM_CAMERA_CAM1_ZONES_FILE=local/zones/cam1/zones.json
# FIM_CAMERA_CAM1_ROTATE_DEG=0

# --- Capture ---------------------------------------------------------------------
FIM_CAPTURE_STALE_TIMEOUT_S=10
FIM_CAPTURE_MAX_READER_LAG_S=5
FIM_CAPTURE_PACKET_BUFFER_S=20
FIM_CAPTURE_MAX_ANALYSIS_WIDTH_PX=1280

# --- Perception ------------------------------------------------------------------
FIM_MODELS_DIR=models
FIM_PERSON_DETECTOR_MODEL=yolox_m_humanart
FIM_PERSON_DETECTOR_MIN_SCORE=0.1
FIM_PERSON_DETECTOR_MAX_FPS=4
FIM_TRACKER_NEW_TRACK_MIN_SCORE=0.3
FIM_TRACKER_LOST_TRACK_TIMEOUT_S=3
FIM_POSE_ESTIMATOR_MODEL=rtmpose_s
FIM_ANALYSIS_EMPTY_SCENE_FPS=3
FIM_ANALYSIS_PERSON_VISIBLE_FPS=8
FIM_ANALYSIS_PERSON_HOLD_S=3
FIM_ANALYSIS_MIN_FPS=0.5

# --- Detectors -------------------------------------------------------------------
FIM_FALL_DETECTOR_ENABLED=true
FIM_FALL_CONFIRMATION_ENABLED=true
FIM_FALL_CONFIRMATION_MAX_FPS=12
FIM_FALL_CONFIRMATION_BEFORE_S=2
FIM_FALL_CONFIRMATION_AFTER_S=3
FIM_PERSON_DOWN_DETECTOR_ENABLED=true
FIM_PERSON_DOWN_DETECTOR_AFTER_FALL_S=30
FIM_PERSON_DOWN_DETECTOR_WITHOUT_FALL_S=60
# Experimental possible head impact (anywhere outside safe zones).
FIM_HEAD_IMPACT_DETECTOR_ENABLED=true
FIM_HEAD_IMPACT_MIN_EVIDENCE=2
FIM_HEAD_IMPACT_WINDOW_S=3
# Audio for thump evidence; inform everyone in the monitored space.
FIM_AUDIO_ENABLED=true
FIM_AUDIO_THUMP_MIN_DB=12

# --- Alerts ----------------------------------------------------------------------
# Events at or above this confidence (0-1) are notified; the rest are near-misses.
FIM_ALERT_MIN_CONFIDENCE=0.5
# Notification language (en or pt-BR) and time zone of the times shown.
FIM_ALERT_LANGUAGE=en
FIM_ALERT_TIMEZONE=UTC
FIM_ALERT_AGGREGATION_WINDOW_S=300
FIM_ALERT_LATE_AFTER_S=60

# --- Telegram --------------------------------------------------------------------
FIM_TELEGRAM_ENABLED=false
# FIM_TELEGRAM_BOT_TOKEN=123456:token-from-botfather
# FIM_TELEGRAM_CHAT_IDS=-1001234567890
FIM_TELEGRAM_VIDEO_UPLOAD_TIMEOUT_S=600

# --- Webhook ---------------------------------------------------------------------
# FIM_WEBHOOK_URL=https://example.invalid/hook
FIM_WEBHOOK_TIMEOUT_S=10

# --- Event log and outbox -----------------------------------------------------
FIM_EVENT_LOG_FILE=/events/events.jsonl
FIM_OUTBOX_DIR=/events/outbox

# --- Health ----------------------------------------------------------------------
FIM_HEALTH_CHECK_INTERVAL_S=5
# Report a camera without video after this many seconds (keep it at most 60).
FIM_HEALTH_CAMERA_LOST_S=30
FIM_HEALTH_RESTORE_AFTER_S=30
FIM_HEALTH_CAMERA_MAX_RECONNECTS=3
FIM_HEALTH_RECONNECT_WINDOW_S=600
FIM_HEALTH_MAX_PROCESSING_FAILURES=5
FIM_HEALTH_DATABASE_BACKLOG_MAX_AGE_S=300
FIM_HEALTH_STALL_EXIT_S=180
FIM_HEALTH_STATE_FILE=/events/health_state.json

# --- Recording and event clips ---------------------------------------------------
# MediaMTX's configuration is generated from the camera variables above at start-up.
FIM_MEDIAMTX_RTSP_URL=rtsp://mediamtx:8554
FIM_MEDIAMTX_PLAYBACK_URL=http://mediamtx:9996
FIM_RECORDINGS_DIR=/recordings
FIM_RECORDINGS_MAX_AGE_H=168
FIM_RECORDINGS_MAX_GB=200
FIM_RECORDINGS_DISK_MIN_FREE_GB=10
FIM_EVENT_CLIP_DIR=/events
FIM_EVENT_CLIP_PRE_S=10
FIM_EVENT_CLIP_POST_S=20
FIM_EVENT_CLIP_MAX_MB=50
FIM_EVENT_CLIP_RETENTION_DAYS=30

# --- Database --------------------------------------------------------------------
# Used by the postgres service and the app. Choose a long random value.
FIM_DB_PASSWORD=change-me
FIM_DB_HOST=postgres
FIM_DB_PORT=5432
FIM_DB_NAME=fim
FIM_DB_USER=fim

# --- Development -----------------------------------------------------------------
# Simulated camera (compose profile "sim"): a video file (relative to FIM_SIM_MEDIA_DIR)
# looped into MediaMTX. Set FIM_CAMERA_CAM1_MAIN_URL=publisher to use it.
FIM_SIM_MEDIA_DIR=./test_videos
FIM_SIM_FILE=sample.mp4
FIM_SIM_TARGET=rtsp://mediamtx:8554/cam1
