# Copy to .env and fill in. Never commit .env.
# Every variable is documented in README.md ("Configuration").

# --- Application -----------------------------------------------------------
FIM_LOG_LEVEL=INFO
# Comma-separated camera ids (lowercase letters, digits, underscore).
FIM_CAMERAS=cam1
# Main (high-quality) stream of each camera. Credentials are masked in logs.
FIM_CAMERA_CAM1_MAIN_URL=rtsp://user:password@camera-host:554/stream1
# Optional substream used for analysis (recommended).
FIM_CAMERA_CAM1_SUB_URL=rtsp://user:password@camera-host:554/stream2
# Optional zone file (allowed-lying and hazard zones); keep it in a git-ignored path.
# FIM_CAMERA_CAM1_ZONES_FILE=local/zones/cam1.json
FIM_STALE_TIMEOUT_S=10
FIM_PACKET_BUFFER_S=20
FIM_MEDIAMTX_API_URL=http://mediamtx:9996

# --- Perception ------------------------------------------------------------------
FIM_MODELS_DIR=models
FIM_DETECTOR_MODEL=yolox_m_humanart
FIM_DETECTOR_SCORE_THRESHOLD=0.1
FIM_POSE_MODEL=rtmpose_s
FIM_EMPTY_FPS=1
FIM_PERSON_FPS=5
FIM_MIN_ANALYSIS_FPS=0.5
FIM_NEW_TRACK_MIN_SCORE=0.3
FIM_TRACK_LOST_S=3
FIM_PERSON_HOLD_S=3

# --- Detectors -------------------------------------------------------------
# Events at or above this confidence (0-1) are notified; the rest are near-misses.
FIM_ALERT_CONFIDENCE_THRESHOLD=0.5
FIM_FALL_DETECTOR_ENABLED=true
FIM_FLOOR_DETECTOR_ENABLED=true
FIM_PERSON_DOWN_S=30
FIM_FLOOR_NO_FALL_S=60

# --- MediaMTX (relay and recorder) -------------------------------------------
# Source of each relayed path. Usually the same values as the camera URLs above.
MTX_PATHS_CAM1_SOURCE=rtsp://user:password@camera-host:554/stream1
MTX_PATHS_CAM1SUB_SOURCE=rtsp://user:password@camera-host:554/stream2

# --- Development only: simulated camera (compose profile "sim") -------------
# Video file (relative to SIM_MEDIA_DIR) looped into MediaMTX.
SIM_MEDIA_DIR=./test_videos
SIM_FILE=sample.mp4
SIM_TARGET=rtsp://mediamtx:8554/cam1
